{
  "version": "1.3.0",
  "status": "design_defaults_not_runtime_implementation",
  "schema_catalog": "../output-schemas/v2/registry.json",
  "pointer_syntax": {
    "root": "selectors 相对已解包来源内容的 JSON 根；业务产物保留模型结果信封，因此通常从 /payload 开始，nexo_graph 从 Project 根开始。空字符串表示根。",
    "array_wildcard": "* 是配置中的数组 schema 遍历通配符，不是 RFC 6901 实例 JSON Pointer。读取后必须展开为含数字索引的准确 JSON Pointer，并附稳定条目 ID。",
    "escaping": "字段名中的 ~ 和 / 依 RFC 6901 转义为 ~0 和 ~1。不得使用递归下降、任意表达式或名称猜测。",
    "validation": "发布配置时将 selectors 沿实际 Schema 的 properties/items/$ref/anyOf 展开校验；payload=null 或尚未完成阶段要求的 needs_input 输出不能作为阶段可用材料。"
  },
  "selection_rules": {
    "version_binding": "任务启动或获准重定基线时，把每个来源绑定为 project_id + artifact_id/record_id + 明确版本 + schema_id/version/hash；同一 Run 使用 ContextSnapshot 的固定清单。业务产物必须是已持久化版本，不能在每次读取时重新解析 latest。 审核按 reviewed_artifact_refs 读取已保存的明确候选草稿，不要求候选已通过本次审核；候选仍标草稿，审核通过后交付相同版本。",
    "dependency_binding": "Stage 引用优先沿已固定父产物的 EvidenceRef 解析，例如 adaptation_plan.stage_artifact_refs；Task 显式输入用于最初绑定和被修改基线。两者冲突必须先判定旧版继续或新建输入基线，不混拼。",
    "reference_envelope": "每个加载块均带 project_id、source_ref（record_id/version/item_id/json_pointer）、实际 ArtifactVersion 或不可变记录身份、schema_id/version/hash、scope、准确 selectors、读取原因与快照时的生效/确认范围。内建投影还带 projection_id/version、来源记录列表及内容哈希；产物与 Decision 必须带固定十进制版本；消息、RuntimeEvent、Checkpoint、ContextSnapshot 等非版本化不可变记录可 version=null，ConfigVersion 按数据契约引用固定记录 ID。包络由程序提供，材料正文不能签发身份或状态。",
    "required": "required=true 表示相应子任务开始前必须解析、读到并校验；load=on_demand 仅改变加载时机。有效空集合允许，来源缺失/失败不等于空。任何材料一旦被声明为直接依赖，即使此模板 required=false 也须读取。",
    "load": "auto 由 Harness 预取；on_demand 在 Agent 工具请求或对应消费子任务前展开。引用本身不足以满足要求正文的必需材料。",
    "detail": "full 为 selectors 指向内容的完整值；index 为所列目录/定位字段且不代表全文阅读；ref 仅保留固定引用。改变 full 为 index/ref 不解除 complete_scope 的后续展开义务。",
    "priority": "整数越大越先装入预算；低优先级必需材料仍不可丢弃。Step3–11 超预算可按契约分批；Step1 的全文或固定窗口都是不可裁剪的必需输入，实际总上下文超限即暂停。Step2 固定读取两份 Step1 产物并生成结构化知识资产。",
    "coverage": "complete_scope 要求固定目标范围内全部选中字段/条目最终被读取并完成任务检查；context_only 仅提供控制/索引/工作连续性；evidence_only 只证明实际展开的证据。索引、摘要和 top-k 不算全量覆盖。",
    "common": "每个 profile 先加载 common_materials，再按源身份/版本/字段/范围去重；工作摘要非权威且仅当已有有效摘要时加载。",
    "config_boundary": "允许 HTML 调整 selectors、scope_filter 注册名、load、detail、priority 及可选材料。不得通过配置绕过项目隔离、固定版本、阶段前置确认、必需约束或全量覆盖；修改必须通过静态路径与依赖检查，并生成 ConfigVersion。",
    "step1_full_text": "Step1 两路按各自模型估算原文 token。未超过 trigger_tokens 且全文请求可放进该路输入预算时，各自直接读取冻结原作全文；否则按各自 window_tokens 上限独立扫描，并为指令、索引及必要的人物连续性材料预留输入预算。作品事件分支只在完整事件边界提交，逐事件 analysis 随事件保存；人物分支按实际阅读并校验的连续原文前缀提交，不依赖作品事件边界。两路阅读覆盖各自校验直至全文。窗口预算不足或无法安全推进时暂停；原文不得以摘要或索引替代。"
  },
  "builtin_sources": {
    "runtime.task_frame": {
      "fields": [
        "request_refs",
        "goal",
        "scope",
        "task_ref",
        "config_ref"
      ],
      "source": "固定 Task、当前请求 HistoryRecord、Run 的配置快照；goal 是任务授权目标的程序投影，不由模型扩张。"
    },
    "runtime.applicable_controls": {
      "fields": [
        "decision_refs",
        "confirmation_refs",
        "constraint_items"
      ],
      "source": "当前范围生效的 Decision、Confirmation、ArtifactState 的固定快照；constraint_items 给出规则正文、来源和适用范围。空集合是已查询无记录，不是漏读。"
    },
    "runtime.work_history": {
      "fields": [
        "recent_message_refs",
        "current_exchange_refs",
        "pending_tool_call_refs"
      ],
      "source": "所选 WorkSession 的原始 HistoryRecord 和尚待后续调用消费的 ToolCall 记录；引用展开为实际消息/工具结果，遵守成对交互和历史预算。"
    },
    "runtime.project_state": {
      "fields": [
        "artifact_refs",
        "active_task_refs",
        "pending_question_refs",
        "pending_confirmation_refs"
      ],
      "source": "项目内任务、产物生效状态和待处理事项的持久快照；以真实记录为依据，不从模型文本推断完成或确认。"
    },
    "runtime.source_block": {
      "fields": [
        "source_ref",
        "text",
        "start_utf16",
        "end_utf16"
      ],
      "source": "冻结原作 ArtifactVersion/Blob 中的原样文本区间，仅供 Step3–11 的证据或章节材料读取；保留原始空格、换行、Unicode，区间为 UTF-16 半开区间，不能替代 Step1 全文。"
    },
    "runtime.source_index": {
      "fields": [
        "source_ref",
        "sections"
      ],
      "source": "冻结原作的程序索引。sections 含稳定 section_id、原题名（无则 null）和起止 UTF-16 区间；没有标题时按物理段落范围索引，不虚构章节。"
    },
    "runtime.batch_state": {
      "fields": [
        "manifest_ref",
        "current_batch_id",
        "owned_source_ranges",
        "neighbor_source_ranges",
        "processed_item_refs",
        "pending_item_refs",
        "continuity_refs"
      ],
      "source": "Step3–11 固定内部 batch_manifest 和当前批次检查点的投影；材料按区间、事件/章/节点按稳定条目引用。衔接资料从已保存批次结果展开，邻接不计完成覆盖。不是 Agent output_type 的新增字段，Step1 不创建或使用分批状态。"
    },
    "runtime.target_contract": {
      "fields": [
        "schema_ref",
        "capability_ref"
      ],
      "source": "Run 固定的输出 Schema 版本/哈希及 Nexo 能力规则配置；执行要求已加载相同正文时只保留引用，避免重复占用输入。"
    },
    "runtime.graph_write_context": {
      "fields": [
        "baseline_ref",
        "target_chapter_id",
        "reserved_identity_refs",
        "metadata_ref",
        "change_scope"
      ],
      "source": "程序冻结的 Project 基线、目标章及身份/元数据分配快照。首建也须先存初始 Project 基线；整剧模式 target_chapter_id=null，change_scope 列明全部目标章节。"
    },
    "runtime.review_context": {
      "fields": [
        "reviewed_artifact_refs",
        "criteria_ref",
        "program_check_refs",
        "covered_item_refs",
        "pending_item_refs"
      ],
      "source": "本次审核固定版本清单、审核配置、真实程序检查结果及审核覆盖检查点；criteria/program_check 引用须展开，不能凭引用宣告检查通过。"
    },
    "runtime.archive_window": {
      "fields": [
        "history_refs",
        "decision_refs",
        "artifact_refs",
        "tool_call_refs"
      ],
      "source": "摘要任务指定的原始归档区间，或历史问答实际命中的原始记录集合。所有引用保留项目归属、记录身份及版本，并按需展开原文；搜索无结果与读取失败分别报告。"
    },
    "runtime.full_source": {
      "fields": [
        "source_ref",
        "text",
        "start_utf16",
        "end_utf16"
      ],
      "source": "冻结 source_text ArtifactVersion/Blob 的权威原作文本；全文模式载入 [0,N)，窗口模式载入 Harness 确定的绝对 UTF-16 区间。两种模式都原样保留空格、换行、Unicode，不裁剪本次要求的范围，固定版本及哈希可追溯。",
      "range": {
        "start_utf16": "zero_or_window_start",
        "end_utf16": "source_length_or_window_end"
      },
      "truncate": false
    }
  },
  "scope_filters": {
    "task_scope": "按 Task 固定 project/stage/chapter/branch/目标条目范围选择；范围不明确时先解析或询问。它不是相似度 top-k。",
    "all_pinned": "读取来源绑定中的全部固定版本及所列字段；不自动追踪当前最新版本。",
    "current_batch": "依据固定批次清单选择本批拥有的完整事件/人物/章节节点条目，及显式登记的邻接材料。事件批次必须另覆盖没有关联事件的人物；邻接不能重复计入完成。",
    "source_evidence": "沿已加载来源锚点或 EvidenceRef 解析原文固定版本与范围；允许远处片段，禁止以标题或同名角色猜位置。",
    "selected_player": "以已确认玩家身份的 character_ref 匹配 character_views.character_id，并加载关联 events；新创玩家无原作身份时返回有依据的空集，不伪造原作人物。",
    "referenced_entities": "按目标事件/章节正文/方案引用收集相关角色和地点的稳定 ID，保留明确所需关系；无法确定关联范围时加载完整目录或分批，不能随意丢弃。",
    "target_chapters": "按 Task 的稳定 chapter_id 选择完整章节设计或 Project.chapters 元素；未划章时按固定待划章事件范围；整剧模式取固定清单内全部章。Project 根元数据、variables/scenes/chapterEdges 不因过滤 chapters 被删除。",
    "chapter_dependencies": "按目标章节、章节设计 game_event_refs/entry_exit_contracts/global_entity_refs/state_requirements 及方案 stage_artifact_refs 追溯所需固定版本，加载跨章契约；没有明确章节绑定时先载全局事件索引。",
    "review_scope": "按本次审核清单选择全部应审条目，分批完整展开正文与互动；每个节点、互动、全局变量及跨章关系均纳入对应检查范围，索引不算全文审核。",
    "history_query": "仅在本项目按用户问题搜索；命中只是候选，回答历史原因前须展开当时原始记录和版本。历史版本允许失效，但必须标明当时/当前状态。",
    "summary_window": "按本次摘要任务固定的消息区间与当前有效状态选择原始记录，已覆盖消息可去重但不能仅重复概括旧摘要。",
    "full_source": "返回 Step1 当前要求的固定原作全文或滑动窗口区间，带绝对 UTF-16 起止索引；不允许截断该区间或用摘要、top-k 替代。调用超预算时暂停，不推进游标。"
  },
