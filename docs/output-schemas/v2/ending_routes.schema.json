{
  "type": "object",
  "properties": {
    "result_kind": {
      "type": "string",
      "enum": [
        "ready",
        "needs_input"
      ]
    },
    "payload": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "endings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "ending_id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "summary": {
                    "type": "string"
                  },
                  "player_experience": {
                    "type": "string"
                  },
                  "achievement_conditions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "语义上的达成条件；用 condition 节点的 conditionDsl 实现，不是 chapterEdges/普通 Edge 上的条件。"
                  },
                  "character_outcomes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "world_outcome": {
                    "type": "string"
                  }
                },
                "required": [
                  "ending_id",
                  "title",
                  "summary",
                  "player_experience",
                  "achievement_conditions",
                  "character_outcomes",
                  "world_outcome"
                ],
                "additionalProperties": false
              }
            },
            "routes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "route_id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "ending_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "key_choices": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "divergences": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "merges": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "causal_rationale": {
                    "type": "string"
                  },
                  "game_event_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "本条路线使用的 Step5/6 游戏事件稳定 ID；必须存在于固定输入。"
                  }
                },
                "required": [
                  "route_id",
                  "name",
                  "ending_ids",
                  "key_choices",
                  "divergences",
                  "merges",
                  "causal_rationale",
                  "game_event_ids"
                ],
                "additionalProperties": false,
                "description": "叙事路线与结局的大致结构；不在本阶段生成章节正文或 Graph。"
              }
            },
            "state_requirements": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/StateRequirement"
              }
            }
          },
          "required": [
            "endings",
            "routes",
            "state_requirements"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Question"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "result_kind",
    "payload",
    "questions",
    "evidence_refs",
    "notes"
  ],
  "additionalProperties": false,
  "description": "Step7 只生成结局、路线和进入条件；所有记录来源与版本由 Harness 关联。",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BranchAgent_ending_routes_v3",
  "$defs": {
    "EvidenceRef": {
      "type": "object",
      "properties": {
        "record_id": {
          "type": "string",
          "description": "真实来源记录或产物 ID；由 Harness 验证存在性与项目归属。"
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "description": "版本化记录必须提供固定版本；普通消息可为 null。"
            },
            {
              "type": "null"
            }
          ]
        },
        "item_id": {
          "anyOf": [
            {
              "type": "string",
              "description": "记录内部的稳定条目 ID。"
            },
            {
              "type": "null"
            }
          ]
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string",
              "description": "需要定位字段时使用 JSON Pointer。"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "record_id",
        "version",
        "item_id",
        "json_pointer"
      ],
      "additionalProperties": false,
      "description": "模型引用已存在记录，不由模型签发确认、版本或审计身份。"
    },
    "Question": {
      "type": "object",
      "properties": {
        "question_id": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "target_field": {
          "anyOf": [
            {
              "type": "string",
              "description": "当前 payload 内的 JSON Pointer。"
            },
            {
              "type": "null"
            }
          ]
        },
        "suggested_answers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocking_scope": {
          "type": "string",
          "description": "明确说明哪些工作依赖此回答。"
        }
      },
      "required": [
        "question_id",
        "prompt",
        "reason",
        "target_field",
        "suggested_answers",
        "blocking_scope"
      ],
      "additionalProperties": false
    },
    "StateRequirement": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "建议的稳定英文变量 key；在全局变量登记中检查冲突。"
        },
        "name": {
          "type": "string"
        },
        "value_type": {
          "type": "string",
          "enum": [
            "number",
            "string",
            "boolean"
          ]
        },
        "initial_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "purpose": {
          "type": "string"
        },
        "used_by_item_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "引用本次 payload 内的路线／互动 ID，不能编造未来的持久产物版本。"
        }
      },
      "required": [
        "key",
        "name",
        "value_type",
        "initial_value",
        "purpose",
        "used_by_item_ids"
      ],
      "additionalProperties": false,
      "description": "设计提案，不自动新增或修改生效变量；初始 JSON 类型必须匹配 value_type。 Step10 将 number/boolean 初始值转换为合法的字符串 Variable.value；字符串内容原样保留。循环/再次访问节点本身不会自动恢复变量。"
    }
  }
}
