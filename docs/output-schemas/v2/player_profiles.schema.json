{
  "type": "object",
  "properties": {
    "result_kind": {
      "type": "string",
      "enum": [
        "ready",
        "needs_input"
      ]
    },
    "payload": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "ending_routes_ref": {
              "$ref": "#/$defs/EvidenceRef"
            },
            "profiles": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "profile_id": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "motivations": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "genre_preferences": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "emotional_preferences": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "choice_complexity": {
                    "type": "string"
                  },
                  "challenge_preferences": {
                    "type": "string"
                  },
                  "content_boundaries": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/EvidenceRef"
                    }
                  }
                },
                "required": [
                  "profile_id",
                  "description",
                  "motivations",
                  "genre_preferences",
                  "emotional_preferences",
                  "choice_complexity",
                  "challenge_preferences",
                  "content_boundaries",
                  "evidence_refs"
                ],
                "additionalProperties": false
              }
            },
            "design_implications": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "profile_id": {
                    "type": "string"
                  },
                  "related_refs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/EvidenceRef"
                    }
                  },
                  "requirement": {
                    "type": "string"
                  }
                },
                "required": [
                  "profile_id",
                  "related_refs",
                  "requirement"
                ],
                "additionalProperties": false
              }
            },
            "assumptions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "未验证的受众判断；不能伪装成调研结论。"
            },
            "game_event_view_ref": {
              "$ref": "#/$defs/EvidenceRef"
            }
          },
          "required": [
            "ending_routes_ref",
            "profiles",
            "design_implications",
            "assumptions",
            "game_event_view_ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Question"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "result_kind",
    "payload",
    "questions",
    "evidence_refs",
    "notes"
  ],
  "additionalProperties": false,
  "description": "模型输出合同：ready 表示有待验证产物；needs_input 返回具体缺项。此字段不决定保存、确认、完成或生效状态。",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BranchAgent_player_profiles_v1",
  "$defs": {
    "EvidenceRef": {
      "type": "object",
      "properties": {
        "record_id": {
          "type": "string",
          "description": "真实来源记录或产物 ID；由 Harness 验证存在性与项目归属。"
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "description": "版本化记录必须提供固定版本；普通消息可为 null。"
            },
            {
              "type": "null"
            }
          ]
        },
        "item_id": {
          "anyOf": [
            {
              "type": "string",
              "description": "记录内部的稳定条目 ID。"
            },
            {
              "type": "null"
            }
          ]
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string",
              "description": "需要定位字段时使用 JSON Pointer。"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "record_id",
        "version",
        "item_id",
        "json_pointer"
      ],
      "additionalProperties": false,
      "description": "模型引用已存在记录，不由模型签发确认、版本或审计身份。"
    },
    "Question": {
      "type": "object",
      "properties": {
        "question_id": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "target_field": {
          "anyOf": [
            {
              "type": "string",
              "description": "当前 payload 内的 JSON Pointer。"
            },
            {
              "type": "null"
            }
          ]
        },
        "suggested_answers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocking_scope": {
          "type": "string",
          "description": "明确说明哪些工作依赖此回答。"
        }
      },
      "required": [
        "question_id",
        "prompt",
        "reason",
        "target_field",
        "suggested_answers",
        "blocking_scope"
      ],
      "additionalProperties": false
    }
  }
}
