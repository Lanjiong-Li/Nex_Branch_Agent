{
  "type": "object",
  "properties": {
    "result_kind": {
      "type": "string",
      "enum": [
        "ready",
        "needs_input"
      ]
    },
    "payload": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "events": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "game_event_id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "summary": {
                    "type": "string"
                  },
                  "character_refs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/EvidenceRef"
                    }
                  },
                  "player_goal": {
                    "type": "string"
                  },
                  "participation": {
                    "type": "string"
                  },
                  "adaptation_kind": {
                    "type": "string",
                    "enum": [
                      "preserved",
                      "modified",
                      "merged",
                      "new"
                    ]
                  },
                  "preconditions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "consequences": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "叙事后果与状态变化需求；状态变化在落图时显式转为 variable 节点的 scriptDsl，不嵌入 choice/QTE 或边。"
                  },
                  "narrative_function": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Step6 补充的事件叙事功能；Step5 初稿为 null，Step6 确认后必须填写。"
                  },
                  "source_anchors": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/SourceAnchor"
                    },
                    "description": "游戏事件独立锚定固定原作；修改或合并可有多个区间，纯新增事件可为空。"
                  }
                },
                "required": [
                  "game_event_id",
                  "title",
                  "summary",
                  "character_refs",
                  "player_goal",
                  "participation",
                  "adaptation_kind",
                  "preconditions",
                  "consequences",
                  "narrative_function",
                  "source_anchors"
                ],
                "additionalProperties": false
              }
            },
            "event_links": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "from_event_id": {
                    "type": "string"
                  },
                  "to_event_id": {
                    "type": "string"
                  },
                  "relation": {
                    "type": "string",
                    "enum": [
                      "temporal",
                      "causal",
                      "alternative"
                    ]
                  },
                  "condition": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "rationale": {
                    "type": "string"
                  }
                },
                "required": [
                  "from_event_id",
                  "to_event_id",
                  "relation",
                  "condition",
                  "rationale"
                ],
                "additionalProperties": false
              },
              "description": "事件层的时间、因果和备选关系，用于设计推理，不是 Chapter.edges 或 chapterEdges。condition 为叙事条件需求，后续必须显式落到 condition 节点；不能直接写成最终边条件。"
            },
            "source_coverage": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CoverageItem"
              }
            }
          },
          "required": [
            "events",
            "event_links",
            "source_coverage"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Question"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "result_kind",
    "payload",
    "questions",
    "evidence_refs",
    "notes"
  ],
  "additionalProperties": false,
  "description": "模型输出合同：ready 表示有待验证产物；needs_input 返回具体缺项。此字段不决定保存、确认、完成或生效状态。",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BranchAgent_game_event_view_v2_3",
  "$defs": {
    "CoverageItem": {
      "type": "object",
      "properties": {
        "disposition": {
          "type": "string",
          "enum": [
            "used",
            "adapted",
            "omitted",
            "pending"
          ]
        },
        "reason": {
          "type": "string"
        },
        "target_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_anchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceAnchor"
          },
          "description": "直接指向原文区间，不通过 Step1 事件引用。"
        }
      },
      "required": [
        "disposition",
        "reason",
        "target_ids",
        "source_anchors"
      ],
      "additionalProperties": false
    },
    "EvidenceRef": {
      "type": "object",
      "properties": {
        "record_id": {
          "type": "string",
          "description": "真实来源记录或产物 ID；由 Harness 验证存在性与项目归属。"
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "description": "版本化记录必须提供固定版本；普通消息可为 null。"
            },
            {
              "type": "null"
            }
          ]
        },
        "item_id": {
          "anyOf": [
            {
              "type": "string",
              "description": "记录内部的稳定条目 ID。"
            },
            {
              "type": "null"
            }
          ]
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string",
              "description": "需要定位字段时使用 JSON Pointer。"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "record_id",
        "version",
        "item_id",
        "json_pointer"
      ],
      "additionalProperties": false,
      "description": "模型引用已存在记录，不由模型签发确认、版本或审计身份。"
    },
    "Question": {
      "type": "object",
      "properties": {
        "question_id": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "target_field": {
          "anyOf": [
            {
              "type": "string",
              "description": "当前 payload 内的 JSON Pointer。"
            },
            {
              "type": "null"
            }
          ]
        },
        "suggested_answers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocking_scope": {
          "type": "string",
          "description": "明确说明哪些工作依赖此回答。"
        }
      },
      "required": [
        "question_id",
        "prompt",
        "reason",
        "target_field",
        "suggested_answers",
        "blocking_scope"
      ],
      "additionalProperties": false
    },
    "SourceAnchor": {
      "type": "object",
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/EvidenceRef"
        },
        "start_utf16": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "end_utf16": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "exact_quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "原样短摘录；若使用程序提供的可信UTF-16索引区间，可为null，且start_utf16/end_utf16均须为合法整数。不需要为声明全本覆盖重复输出完整原文。"
        },
        "prefix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "suffix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source_ref",
        "start_utf16",
        "end_utf16",
        "exact_quote",
        "prefix",
        "suffix"
      ],
      "additionalProperties": false,
      "description": "UTF-16 code units半开区间[start,end)。可直接引用程序给定原文索引并将exact_quote设为null；无法确定索引时提供原样短摘录，将两端设为null由程序唯一定位。禁止三者同时为null；重复摘录不能猜位置。"
    }
  }
}
