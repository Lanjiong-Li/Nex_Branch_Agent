{
  "type": "object",
  "properties": {
    "result_kind": {
      "type": "string",
      "enum": [
        "ready",
        "needs_input"
      ]
    },
    "payload": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "chapter": {
              "$ref": "#/$defs/Chapter"
            },
            "shared_scenes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Scene"
              }
            },
            "shared_variables": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Variable"
              }
            },
            "removed_node_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "removed_edge_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "chapter",
            "shared_scenes",
            "shared_variables",
            "removed_node_ids",
            "removed_edge_ids"
          ],
          "additionalProperties": false,
          "description": "Step10 返回完整单章快照；未改节点/连线仍须完整保留。相对冻结基线消失的 ID 必须精确列在 removed_* 并通过删除授权/引用检查。共享对象是待核验提案，不隐式覆盖全局记录。"
        },
        {
          "type": "null"
        }
      ]
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Question"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "result_kind",
    "payload",
    "questions",
    "evidence_refs",
    "notes"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BranchAgent_chapter_graph_v2",
  "$defs": {
    "ScriptInlinePlacement": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "afterLine": {
          "type": "integer",
          "minimum": 0
        },
        "order": {
          "type": "number"
        }
      },
      "required": [
        "version",
        "afterLine",
        "order"
      ],
      "additionalProperties": false,
      "description": "互动插在 body 以换行拆分后的第 afterLine 行之后，0 基；order 决定同一位置顺序。不是原作 UTF-16 偏移，也不是时间轴。"
    },
    "Choice": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "action": {
          "type": "string",
          "enum": [
            "continue",
            "jump"
          ]
        },
        "label": {
          "type": "string"
        },
        "targetNodeId": {
          "type": "string",
          "description": "continue 时为空字符串；jump 的完成稿必须解析到同章目标节点。"
        }
      },
      "required": [
        "id",
        "action",
        "label",
        "targetNodeId"
      ],
      "additionalProperties": false
    },
    "ChoiceGroup": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "scriptInline": {
          "$ref": "#/$defs/ScriptInlinePlacement"
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Choice"
          }
        }
      },
      "required": [
        "id",
        "name",
        "scriptInline",
        "choices"
      ],
      "additionalProperties": false
    },
    "Qte": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "scriptInline": {
          "$ref": "#/$defs/ScriptInlinePlacement"
        },
        "failureEnabled": {
          "type": "boolean"
        },
        "failureAction": {
          "type": "string",
          "enum": [
            "continue",
            "jump"
          ]
        },
        "failureTargetNodeId": {
          "type": "string"
        },
        "successAction": {
          "type": "string",
          "enum": [
            "continue",
            "jump"
          ]
        },
        "successTargetNodeId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "scriptInline",
        "failureEnabled",
        "failureAction",
        "failureTargetNodeId",
        "successAction",
        "successTargetNodeId"
      ],
      "additionalProperties": false,
      "description": "成功/失败分别选择 continue 或 jump。禁用失败没有可视边，但可保留已验证的失败草稿目标。"
    },
    "Condition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "variableId": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": [
            "gt",
            "lt",
            "eq",
            "contains"
          ]
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "variableId",
        "operator",
        "value"
      ],
      "additionalProperties": false
    },
    "Operation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "variableId": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": [
            "set",
            "add",
            "subtract"
          ]
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "variableId",
        "operator",
        "value"
      ],
      "additionalProperties": false
    },
    "Branch": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "and"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "maxItems": 0
        },
        "conditionDsl": {
          "type": "string",
          "description": "唯一权威条件表达式；引用全局变量 key；mode/conditions 仅满足现有领域接口兼容形状。"
        }
      },
      "required": [
        "id",
        "name",
        "mode",
        "conditions",
        "conditionDsl"
      ],
      "additionalProperties": false
    },
    "JumpTarget": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "node",
            "chapter"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false,
      "description": "kind=node 仅同章或下一章的非开始 story 节点，不能指自己；kind=chapter 仅下一章入口。当前 Inspector/store 对同章开始目标不一致，本 profile 按可稳定保存的交集约束。"
    },
