{
  "type": "object",
  "properties": {
    "result_kind": {
      "type": "string",
      "enum": [
        "ready",
        "needs_input"
      ]
    },
    "payload": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "source_ref": {
              "$ref": "#/$defs/EvidenceRef"
            },
            "character_views": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "character_id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "aliases": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "description": {
                    "type": "string"
                  },
                  "events": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "character_event_id": {
                          "type": "string",
                          "description": "人物视图内的独立事件身份，不引用全局事件 ID。"
                        },
                        "title": {
                          "type": "string"
                        },
                        "summary": {
                          "type": "string"
                        },
                        "narrative_order": {
                          "type": "integer"
                        },
                        "story_time": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "involvement": {
                          "type": "string"
                        },
                        "source_anchors": {
                          "type": "array",
                          "items": {
                            "$ref": "#/$defs/SourceAnchor"
                          }
                        }
                      },
                      "required": [
                        "character_event_id",
                        "title",
                        "summary",
                        "narrative_order",
                        "story_time",
                        "involvement",
                        "source_anchors"
                      ],
                      "additionalProperties": false,
                      "description": "人物事件独立切片，必须直接锚定固定原作，不通过全局事件定位。"
                    }
                  }
                },
                "required": [
                  "character_id",
                  "name",
                  "aliases",
                  "description",
                  "events"
                ],
                "additionalProperties": false
              }
            },
            "covered_source_anchors": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SourceAnchor"
              }
            },
            "remaining_source_anchors": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SourceAnchor"
              }
            }
          },
          "required": [
            "source_ref",
            "character_views",
            "covered_source_anchors",
            "remaining_source_anchors"
          ],
          "additionalProperties": false,
          "description": "Step1 主要人物事件视图：独立锚定固定原作，窗口覆盖与完整事件边界由 Harness 校验。"
        },
        {
          "type": "null"
        }
      ]
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Question"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "result_kind",
    "payload",
    "questions",
    "evidence_refs",
    "notes"
  ],
  "additionalProperties": false,
  "description": "模型输出合同：ready 表示有待验证产物；needs_input 返回具体缺项。此字段不决定保存、确认、完成或生效状态。",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BranchAgent_source_character_events_v1_0",
  "$defs": {
    "EvidenceRef": {
      "type": "object",
      "properties": {
        "record_id": {
          "type": "string",
          "description": "真实来源记录或产物 ID；由 Harness 验证存在性与项目归属。"
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "description": "版本化记录必须提供固定版本；普通消息可为 null。"
            },
            {
              "type": "null"
            }
          ]
        },
        "item_id": {
          "anyOf": [
            {
              "type": "string",
              "description": "记录内部的稳定条目 ID。"
            },
            {
              "type": "null"
            }
          ]
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string",
              "description": "需要定位字段时使用 JSON Pointer。"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "record_id",
        "version",
        "item_id",
        "json_pointer"
      ],
      "additionalProperties": false,
      "description": "模型引用已存在记录，不由模型签发确认、版本或审计身份。"
    },
    "Question": {
      "type": "object",
      "properties": {
        "question_id": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "target_field": {
          "anyOf": [
            {
              "type": "string",
              "description": "当前 payload 内的 JSON Pointer。"
            },
            {
              "type": "null"
            }
          ]
        },
        "suggested_answers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocking_scope": {
          "type": "string",
          "description": "明确说明哪些工作依赖此回答。"
        }
      },
      "required": [
        "question_id",
        "prompt",
        "reason",
        "target_field",
        "suggested_answers",
        "blocking_scope"
      ],
      "additionalProperties": false
    },
    "SourceAnchor": {
      "type": "object",
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/EvidenceRef"
        },
        "start_utf16": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "end_utf16": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "exact_quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "原样短摘录；若使用程序提供的可信UTF-16索引区间，可为null，且start_utf16/end_utf16均须为合法整数。不需要为声明全本覆盖重复输出完整原文。"
        },
        "prefix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "suffix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source_ref",
        "start_utf16",
        "end_utf16",
        "exact_quote",
        "prefix",
        "suffix"
      ],
      "additionalProperties": false,
      "description": "UTF-16 code units半开区间[start,end)。可直接引用程序给定原文索引并将exact_quote设为null；无法确定索引时提供原样短摘录，将两端设为null由程序唯一定位。禁止三者同时为null；重复摘录不能猜位置。"
    }
  }
}
