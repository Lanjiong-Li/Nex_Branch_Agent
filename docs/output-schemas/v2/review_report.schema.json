{
  "type": "object",
  "properties": {
    "result_kind": {
      "type": "string",
      "enum": [
        "ready",
        "needs_input"
      ]
    },
    "payload": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "reviewed_artifact_refs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/EvidenceRef"
              }
            },
            "criteria_ref": {
              "$ref": "#/$defs/EvidenceRef"
            },
            "proposed_verdict": {
              "type": "string",
              "enum": [
                "pass",
                "needs_revision",
                "inconclusive"
              ]
            },
            "checked_scope": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unchecked_scope": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "issue_id": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "blocker",
                      "major",
                      "minor",
                      "suggestion"
                    ]
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "structure",
                      "variable",
                      "continuity",
                      "interaction",
                      "constraint",
                      "coverage",
                      "other"
                    ]
                  },
                  "location_ref": {
                    "$ref": "#/$defs/EvidenceRef"
                  },
                  "statement": {
                    "type": "string"
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/EvidenceRef"
                    }
                  },
                  "impact": {
                    "type": "string"
                  },
                  "suggested_fix": {
                    "type": "string"
                  },
                  "suggested_owner": {
                    "type": "string"
                  },
                  "graph_targets": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/GraphTarget"
                    },
                    "description": "图问题列出所有具体受影响对象；纯上游设计问题为 [] 并使用 location_ref。"
                  }
                },
                "required": [
                  "issue_id",
                  "severity",
                  "category",
                  "location_ref",
                  "statement",
                  "evidence_refs",
                  "impact",
                  "suggested_fix",
                  "suggested_owner",
                  "graph_targets"
                ],
                "additionalProperties": false
              }
            },
            "metrics": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "metric_id": {
                    "type": "string"
                  },
                  "value": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "string"
                          },
                          {
                            "type": "boolean"
                          }
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "interpretation": {
                    "type": "string"
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/EvidenceRef"
                    }
                  }
                },
                "required": [
                  "metric_id",
                  "value",
                  "interpretation",
                  "evidence_refs"
                ],
                "additionalProperties": false
              }
            },
            "graph_checks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/GraphCheck"
              },
              "description": "当前可选校验 Agent 必须返回 []。schema_contract 与 unreachable_nodes 由 Harness 独立执行、保存和展示，不作为模型输入，也不由模型签发。"
            }
          },
          "required": [
            "reviewed_artifact_refs",
            "criteria_ref",
            "proposed_verdict",
            "checked_scope",
            "unchecked_scope",
            "findings",
            "metrics",
            "graph_checks"
          ],
          "additionalProperties": false,
          "description": "可选校验 Agent 对最终 Graph 的候选结论；Harness 结合覆盖范围、独立脚本检查、版本与必要确认判定最终放行。校验 Agent 默认关闭，启用后也可以报告不通过。"
        },
        {
          "type": "null"
        }
      ]
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Question"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "result_kind",
    "payload",
    "questions",
    "evidence_refs",
    "notes"
  ],
  "additionalProperties": false,
  "description": "模型输出合同：ready 表示有待验证产物；needs_input 返回具体缺项。此字段不决定保存、确认、完成或生效状态。",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BranchAgent_review_report_v2_1",
  "$defs": {
    "EvidenceRef": {
      "type": "object",
      "properties": {
        "record_id": {
          "type": "string",
          "description": "真实来源记录或产物 ID；由 Harness 验证存在性与项目归属。"
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "description": "版本化记录必须提供固定版本；普通消息可为 null。"
            },
            {
              "type": "null"
            }
          ]
        },
        "item_id": {
          "anyOf": [
            {
              "type": "string",
              "description": "记录内部的稳定条目 ID。"
            },
            {
              "type": "null"
            }
          ]
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string",
              "description": "需要定位字段时使用 JSON Pointer。"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "record_id",
        "version",
        "item_id",
        "json_pointer"
      ],
      "additionalProperties": false,
      "description": "模型引用已存在记录，不由模型签发确认、版本或审计身份。"
    },
    "Question": {
      "type": "object",
      "properties": {
        "question_id": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "target_field": {
          "anyOf": [
            {
              "type": "string",
              "description": "当前 payload 内的 JSON Pointer。"
            },
            {
              "type": "null"
            }
          ]
        },
        "suggested_answers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocking_scope": {
          "type": "string",
          "description": "明确说明哪些工作依赖此回答。"
        }
      },
      "required": [
        "question_id",
        "prompt",
        "reason",
        "target_field",
        "suggested_answers",
        "blocking_scope"
      ],
      "additionalProperties": false
    },
    "GraphTarget": {
      "type": "object",
      "properties": {
        "object_kind": {
          "type": "string",
          "enum": [
            "project",
            "chapter",
            "node",
            "edge",
            "chapter_edge",
            "scene",
            "variable",
            "choice_group",
            "choice",
            "qte",
            "branch"
          ]
        },
        "object_id": {
          "type": "string",
          "description": "被审 Project 中真实稳定 ID；不得只写名称或虚构未来对象。"
        },
        "chapter_id": {
          "anyOf": [
            {
              "type": "string",
              "description": "章内对象所属章节；项目级对象为 null。"
            },
            {
              "type": "null"
            }
          ]
        },
        "node_id": {
          "anyOf": [
            {
              "type": "string",
              "description": "节点子对象所属节点；其他对象为 null。"
            },
            {
              "type": "null"
            }
          ]
        },
        "json_pointer": {
          "type": "string",
          "description": "相对被审固定版本 Project 根的准确 JSON Pointer。"
        }
      },
      "required": [
        "object_kind",
        "object_id",
        "chapter_id",
        "node_id",
        "json_pointer"
      ],
      "additionalProperties": false,
      "description": "精确定位被审最终前端图对象；程序核对 ID、归属和路径一致性。"
    },
    "GraphCheck": {
      "type": "object",
      "properties": {
        "check_id": {
          "type": "string"
        },
        "check_kind": {
          "type": "string",
          "enum": [
            "schema_contract",
            "object_identity",
            "reference_integrity",
            "node_kind_fields",
            "port_routes",
            "chapter_topology",
            "chapter_boundaries",
            "interaction_placement",
            "dsl_and_variables",
            "text_coverage",
            "design_coverage",
            "change_scope"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "unverified",
            "not_applicable"
          ]
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GraphTarget"
          }
        },
        "summary": {
          "type": "string",
          "description": "说明已查事实、失败理由或未查原因；not_applicable 必须给出范围理由。"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "description": "引用被审固定版本及可核验的验证记录；不得以模型自述代替真实检查。"
        }
      },
      "required": [
        "check_id",
        "check_kind",
        "status",
        "targets",
        "summary",
        "evidence_refs"
      ],
      "additionalProperties": false,
      "description": "一项启用的 Graph 程序检查记录；候选报告不签发验证。实际覆盖范围须在 check_id/summary/targets 中明确。交付要求本次启用检查均有真实通过记录；未启用算法不作为首版交付门槛，已启用检查缺失、未查或失败均阻止放行。"
    }
  }
}
