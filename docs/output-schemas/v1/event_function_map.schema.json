{
  "type": "object",
  "properties": {
    "result_kind": {
      "type": "string",
      "enum": [
        "ready",
        "needs_input"
      ]
    },
    "payload": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "game_event_view_ref": {
              "$ref": "#/$defs/EvidenceRef"
            },
            "event_annotations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "game_event_id": {
                    "type": "string",
                    "description": "必须复用 Step5 事件 ID。"
                  },
                  "narrative_functions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "player_intents": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "action_space": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "information_revealed": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "information_withheld": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "conflict_progression": {
                    "type": "string"
                  },
                  "constraints": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/Constraint"
                    }
                  }
                },
                "required": [
                  "game_event_id",
                  "narrative_functions",
                  "player_intents",
                  "action_space",
                  "information_revealed",
                  "information_withheld",
                  "conflict_progression",
                  "constraints"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "game_event_view_ref",
            "event_annotations"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Question"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "result_kind",
    "payload",
    "questions",
    "evidence_refs",
    "notes"
  ],
  "additionalProperties": false,
  "description": "模型输出合同：ready 表示有待验证产物；needs_input 返回具体缺项。此字段不决定保存、确认、完成或生效状态。",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BranchAgent_event_function_map_v1",
  "$defs": {
    "Constraint": {
      "type": "object",
      "properties": {
        "constraint_id": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          }
        }
      },
      "required": [
        "constraint_id",
        "rule",
        "scope",
        "evidence_refs"
      ],
      "additionalProperties": false,
      "description": "约束提取或设计内容；是否已确认由程序从真实来源核对。"
    },
    "EvidenceRef": {
      "type": "object",
      "properties": {
        "record_id": {
          "type": "string",
          "description": "真实来源记录或产物 ID；由 Harness 验证存在性与项目归属。"
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "description": "版本化记录必须提供固定版本；普通消息可为 null。"
            },
            {
              "type": "null"
            }
          ]
        },
        "item_id": {
          "anyOf": [
            {
              "type": "string",
              "description": "记录内部的稳定条目 ID。"
            },
            {
              "type": "null"
            }
          ]
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string",
              "description": "需要定位字段时使用 JSON Pointer。"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "record_id",
        "version",
        "item_id",
        "json_pointer"
      ],
      "additionalProperties": false,
      "description": "模型引用已存在记录，不由模型签发确认、版本或审计身份。"
    },
    "Question": {
      "type": "object",
      "properties": {
        "question_id": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "target_field": {
          "anyOf": [
            {
              "type": "string",
              "description": "当前 payload 内的 JSON Pointer。"
            },
            {
              "type": "null"
            }
          ]
        },
        "suggested_answers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocking_scope": {
          "type": "string",
          "description": "明确说明哪些工作依赖此回答。"
        }
      },
      "required": [
        "question_id",
        "prompt",
        "reason",
        "target_field",
        "suggested_answers",
        "blocking_scope"
      ],
      "additionalProperties": false
    }
  }
}
