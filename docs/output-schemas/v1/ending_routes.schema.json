{
  "type": "object",
  "properties": {
    "result_kind": {
      "type": "string",
      "enum": [
        "ready",
        "needs_input"
      ]
    },
    "payload": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "plan_ref": {
              "$ref": "#/$defs/EvidenceRef"
            },
            "event_function_map_ref": {
              "$ref": "#/$defs/EvidenceRef"
            },
            "endings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "ending_id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "summary": {
                    "type": "string"
                  },
                  "player_experience": {
                    "type": "string"
                  },
                  "achievement_conditions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "character_outcomes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "world_outcome": {
                    "type": "string"
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/EvidenceRef"
                    }
                  }
                },
                "required": [
                  "ending_id",
                  "title",
                  "summary",
                  "player_experience",
                  "achievement_conditions",
                  "character_outcomes",
                  "world_outcome",
                  "evidence_refs"
                ],
                "additionalProperties": false
              }
            },
            "routes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "route_id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "ending_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "event_refs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/EvidenceRef"
                    }
                  },
                  "key_choices": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "divergences": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "merges": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "causal_rationale": {
                    "type": "string"
                  }
                },
                "required": [
                  "route_id",
                  "name",
                  "ending_ids",
                  "event_refs",
                  "key_choices",
                  "divergences",
                  "merges",
                  "causal_rationale"
                ],
                "additionalProperties": false
              }
            },
            "state_requirements": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/StateRequirement"
              }
            }
          },
          "required": [
            "plan_ref",
            "event_function_map_ref",
            "endings",
            "routes",
            "state_requirements"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Question"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "result_kind",
    "payload",
    "questions",
    "evidence_refs",
    "notes"
  ],
  "additionalProperties": false,
  "description": "模型输出合同：ready 表示有待验证产物；needs_input 返回具体缺项。此字段不决定保存、确认、完成或生效状态。",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BranchAgent_ending_routes_v1",
  "$defs": {
    "EvidenceRef": {
      "type": "object",
      "properties": {
        "record_id": {
          "type": "string",
          "description": "真实来源记录或产物 ID；由 Harness 验证存在性与项目归属。"
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "description": "版本化记录必须提供固定版本；普通消息可为 null。"
            },
            {
              "type": "null"
            }
          ]
        },
        "item_id": {
          "anyOf": [
            {
              "type": "string",
              "description": "记录内部的稳定条目 ID。"
            },
            {
              "type": "null"
            }
          ]
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string",
              "description": "需要定位字段时使用 JSON Pointer。"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "record_id",
        "version",
        "item_id",
        "json_pointer"
      ],
      "additionalProperties": false,
      "description": "模型引用已存在记录，不由模型签发确认、版本或审计身份。"
    },
    "Question": {
      "type": "object",
      "properties": {
        "question_id": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "target_field": {
          "anyOf": [
            {
              "type": "string",
              "description": "当前 payload 内的 JSON Pointer。"
            },
            {
              "type": "null"
            }
          ]
        },
        "suggested_answers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocking_scope": {
          "type": "string",
          "description": "明确说明哪些工作依赖此回答。"
        }
      },
      "required": [
        "question_id",
        "prompt",
        "reason",
        "target_field",
        "suggested_answers",
        "blocking_scope"
      ],
      "additionalProperties": false
    },
    "StateRequirement": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "建议的稳定英文变量 key；在全局变量登记中检查冲突。"
        },
        "name": {
          "type": "string"
        },
        "value_type": {
          "type": "string",
          "enum": [
            "number",
            "string",
            "boolean"
          ]
        },
        "initial_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "purpose": {
          "type": "string"
        },
        "used_by_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          }
        },
        "used_by_item_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "引用本次 payload 内的路线／互动 ID，不能编造未来的持久产物版本。"
        }
      },
      "required": [
        "key",
        "name",
        "value_type",
        "initial_value",
        "purpose",
        "used_by_refs",
        "used_by_item_ids"
      ],
      "additionalProperties": false,
      "description": "设计提案，不自动新增或修改生效变量；初始 JSON 类型必须匹配 value_type。"
    }
  }
}
