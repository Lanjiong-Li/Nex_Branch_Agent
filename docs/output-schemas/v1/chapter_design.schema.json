{
  "type": "object",
  "properties": {
    "result_kind": {
      "type": "string",
      "enum": [
        "ready",
        "needs_input"
      ]
    },
    "payload": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "chapter_id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "plan_ref": {
              "$ref": "#/$defs/EvidenceRef"
            },
            "game_event_refs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/EvidenceRef"
              }
            },
            "linear_body": {
              "type": "object",
              "properties": {
                "segments": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "segment_id": {
                        "type": "string"
                      },
                      "text": {
                        "type": "string",
                        "description": "完整正文，不是梗概。"
                      },
                      "character_refs": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/EvidenceRef"
                        }
                      },
                      "location_refs": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/EvidenceRef"
                        }
                      },
                      "game_event_refs": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/EvidenceRef"
                        }
                      }
                    },
                    "required": [
                      "segment_id",
                      "text",
                      "character_refs",
                      "location_refs",
                      "game_event_refs"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "segments"
              ],
              "additionalProperties": false,
              "description": "有序正文段是唯一正文来源；全文由程序连接渲染，不另存一份可独立编辑的全文。"
            },
            "interactions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "interaction_id": {
                    "type": "string"
                  },
                  "anchor_segment_id": {
                    "type": "string"
                  },
                  "placement": {
                    "type": "string",
                    "enum": [
                      "before",
                      "after"
                    ]
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "choice",
                      "qte",
                      "game"
                    ]
                  },
                  "prompt": {
                    "type": "string"
                  },
                  "player_intent": {
                    "type": "string"
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "option_id": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        },
                        "availability_requirements": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "outcome": {
                          "$ref": "#/$defs/DesignOutcome"
                        }
                      },
                      "required": [
                        "option_id",
                        "label",
                        "availability_requirements",
                        "outcome"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "action_requirement": {
                    "anyOf": [
                      {
                        "type": "string",
                        "description": "QTE／小游戏的操作要求；选择组可为 null。"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "outcomes": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/DesignOutcome"
                    }
                  }
                },
                "required": [
                  "interaction_id",
                  "anchor_segment_id",
                  "placement",
                  "kind",
                  "prompt",
                  "player_intent",
                  "options",
                  "action_requirement",
                  "outcomes"
                ],
                "additionalProperties": false
              }
            },
            "flow_links": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "from_segment_id": {
                    "type": "string"
                  },
                  "interaction_id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "outcome_id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "target": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "segment",
                          "continue",
                          "chapter",
                          "chapter_end",
                          "story_end",
                          "unresolved"
                        ]
                      },
                      "segment_id": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "chapter_id": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "segment_id",
                      "chapter_id"
                    ],
                    "additionalProperties": false
                  },
                  "condition_requirement": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "from_segment_id",
                  "interaction_id",
                  "outcome_id",
                  "target",
                  "condition_requirement"
                ],
                "additionalProperties": false
              }
            },
            "entry_exit_contracts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "contract_id": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "entry",
                      "transition",
                      "exit"
                    ]
                  },
                  "segment_id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "other_chapter_id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "required_state": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "resulting_state": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "rationale": {
                    "type": "string"
                  }
                },
                "required": [
                  "contract_id",
                  "kind",
                  "segment_id",
                  "other_chapter_id",
                  "required_state",
                  "resulting_state",
                  "rationale"
                ],
                "additionalProperties": false
              }
            },
            "global_entity_refs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/EvidenceRef"
              }
            },
            "state_requirements": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/StateRequirement"
              }
            }
          },
          "required": [
            "chapter_id",
            "title",
            "summary",
            "plan_ref",
            "game_event_refs",
            "linear_body",
            "interactions",
            "flow_links",
            "entry_exit_contracts",
            "global_entity_refs",
            "state_requirements"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Question"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "result_kind",
    "payload",
    "questions",
    "evidence_refs",
    "notes"
  ],
  "additionalProperties": false,
  "description": "模型输出合同：ready 表示有待验证产物；needs_input 返回具体缺项。此字段不决定保存、确认、完成或生效状态。",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BranchAgent_chapter_design_v1",
  "$defs": {
    "DesignOutcome": {
      "type": "object",
      "properties": {
        "outcome_id": {
          "type": "string"
        },
        "result": {
          "type": "string"
        },
        "consequence": {
          "type": "string"
        },
        "condition_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "state_effect_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "outcome_id",
        "result",
        "consequence",
        "condition_requirements",
        "state_effect_requirements"
      ],
      "additionalProperties": false,
      "description": "设计层只定义条件与后果；走向唯一由 flow_links 指定，进入 Step10 时映射为合法节点、出口与 DSL。"
    },
    "EvidenceRef": {
      "type": "object",
      "properties": {
        "record_id": {
          "type": "string",
          "description": "真实来源记录或产物 ID；由 Harness 验证存在性与项目归属。"
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "description": "版本化记录必须提供固定版本；普通消息可为 null。"
            },
            {
              "type": "null"
            }
          ]
        },
        "item_id": {
          "anyOf": [
            {
              "type": "string",
              "description": "记录内部的稳定条目 ID。"
            },
            {
              "type": "null"
            }
          ]
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string",
              "description": "需要定位字段时使用 JSON Pointer。"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "record_id",
        "version",
        "item_id",
        "json_pointer"
      ],
      "additionalProperties": false,
      "description": "模型引用已存在记录，不由模型签发确认、版本或审计身份。"
    },
    "Question": {
      "type": "object",
      "properties": {
        "question_id": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "target_field": {
          "anyOf": [
            {
              "type": "string",
              "description": "当前 payload 内的 JSON Pointer。"
            },
            {
              "type": "null"
            }
          ]
        },
        "suggested_answers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocking_scope": {
          "type": "string",
          "description": "明确说明哪些工作依赖此回答。"
        }
      },
      "required": [
        "question_id",
        "prompt",
        "reason",
        "target_field",
        "suggested_answers",
        "blocking_scope"
      ],
      "additionalProperties": false
    },
    "StateRequirement": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "建议的稳定英文变量 key；在全局变量登记中检查冲突。"
        },
        "name": {
          "type": "string"
        },
        "value_type": {
          "type": "string",
          "enum": [
            "number",
            "string",
            "boolean"
          ]
        },
        "initial_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "purpose": {
          "type": "string"
        },
        "used_by_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          }
        },
        "used_by_item_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "引用本次 payload 内的路线／互动 ID，不能编造未来的持久产物版本。"
        }
      },
      "required": [
        "key",
        "name",
        "value_type",
        "initial_value",
        "purpose",
        "used_by_refs",
        "used_by_item_ids"
      ],
      "additionalProperties": false,
      "description": "设计提案，不自动新增或修改生效变量；初始 JSON 类型必须匹配 value_type。"
    }
  }
}
