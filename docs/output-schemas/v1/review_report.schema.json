{
  "type": "object",
  "properties": {
    "result_kind": {
      "type": "string",
      "enum": [
        "ready",
        "needs_input"
      ]
    },
    "payload": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "reviewed_artifact_refs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/EvidenceRef"
              }
            },
            "criteria_ref": {
              "$ref": "#/$defs/EvidenceRef"
            },
            "proposed_verdict": {
              "type": "string",
              "enum": [
                "pass",
                "needs_revision",
                "inconclusive"
              ]
            },
            "checked_scope": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unchecked_scope": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "issue_id": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "blocker",
                      "major",
                      "minor",
                      "suggestion"
                    ]
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "structure",
                      "variable",
                      "continuity",
                      "interaction",
                      "constraint",
                      "coverage",
                      "other"
                    ]
                  },
                  "location_ref": {
                    "$ref": "#/$defs/EvidenceRef"
                  },
                  "statement": {
                    "type": "string"
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/EvidenceRef"
                    }
                  },
                  "impact": {
                    "type": "string"
                  },
                  "suggested_fix": {
                    "type": "string"
                  },
                  "suggested_owner": {
                    "type": "string"
                  }
                },
                "required": [
                  "issue_id",
                  "severity",
                  "category",
                  "location_ref",
                  "statement",
                  "evidence_refs",
                  "impact",
                  "suggested_fix",
                  "suggested_owner"
                ],
                "additionalProperties": false
              }
            },
            "metrics": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "metric_id": {
                    "type": "string"
                  },
                  "value": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "string"
                          },
                          {
                            "type": "boolean"
                          }
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "interpretation": {
                    "type": "string"
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/EvidenceRef"
                    }
                  }
                },
                "required": [
                  "metric_id",
                  "value",
                  "interpretation",
                  "evidence_refs"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "reviewed_artifact_refs",
            "criteria_ref",
            "proposed_verdict",
            "checked_scope",
            "unchecked_scope",
            "findings",
            "metrics"
          ],
          "additionalProperties": false,
          "description": "审核结论是候选结论；程序结合覆盖范围与确定性规则判定最终放行。审核完成可以报告不通过。"
        },
        {
          "type": "null"
        }
      ]
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Question"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "result_kind",
    "payload",
    "questions",
    "evidence_refs",
    "notes"
  ],
  "additionalProperties": false,
  "description": "模型输出合同：ready 表示有待验证产物；needs_input 返回具体缺项。此字段不决定保存、确认、完成或生效状态。",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BranchAgent_review_report_v1",
  "$defs": {
    "EvidenceRef": {
      "type": "object",
      "properties": {
        "record_id": {
          "type": "string",
          "description": "真实来源记录或产物 ID；由 Harness 验证存在性与项目归属。"
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "description": "版本化记录必须提供固定版本；普通消息可为 null。"
            },
            {
              "type": "null"
            }
          ]
        },
        "item_id": {
          "anyOf": [
            {
              "type": "string",
              "description": "记录内部的稳定条目 ID。"
            },
            {
              "type": "null"
            }
          ]
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string",
              "description": "需要定位字段时使用 JSON Pointer。"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "record_id",
        "version",
        "item_id",
        "json_pointer"
      ],
      "additionalProperties": false,
      "description": "模型引用已存在记录，不由模型签发确认、版本或审计身份。"
    },
    "Question": {
      "type": "object",
      "properties": {
        "question_id": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "target_field": {
          "anyOf": [
            {
              "type": "string",
              "description": "当前 payload 内的 JSON Pointer。"
            },
            {
              "type": "null"
            }
          ]
        },
        "suggested_answers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocking_scope": {
          "type": "string",
          "description": "明确说明哪些工作依赖此回答。"
        }
      },
      "required": [
        "question_id",
        "prompt",
        "reason",
        "target_field",
        "suggested_answers",
        "blocking_scope"
      ],
      "additionalProperties": false
    }
  }
}
