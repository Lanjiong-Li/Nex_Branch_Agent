DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
# Needed only if an Agent selects an OpenAI model.
OPENAI_API_KEY=
DATABASE_URL=postgresql:///branch_agent_local
BRANCH_HOST=127.0.0.1
BRANCH_PORT=8767
# Optional persistent data path. Default: .data in the project directory.
# BRANCH_DATA_DIR=/absolute/persistent/path
# Optional first-start local test login. If omitted, generated credentials are saved privately.
# BRANCH_LOCAL_USER=developer
# BRANCH_LOCAL_PASSWORD=choose-a-local-password
